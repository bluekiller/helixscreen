<?xml version="1.0"?>
<component>
  <!-- Home tile: heater label and current value above a canvas sparkline.
       The canvas is a retained drawing the plugin rebuilds and commits on
       every sample. -->
  <view extends="lv_obj"
        width="100%" height="100%" clickable="true" style_pad_all="#space_sm" style_pad_gap="#space_xs"
        flex_flow="column" scrollable="false">
    <event_cb trigger="clicked" callback="plugin_event" user_data="temp-spark__open"/>
    <lv_label name="temp-spark__heater"
              bind_text="temp-spark__heater_label" style_text_font="#font_heading_micro" style_text_color="#text_muted"/>
    <lv_label name="temp-spark__value"
              bind_text="temp-spark__value" style_text_font="#font_heading_medium" style_text_color="#text"/>
    <plugin_canvas name="temp-spark__spark" width="100%" flex_grow="1"/>
  </view>
</component>
