    <lv_label name="temp-spark__heater"
              bind_text="temp-spark__heater_label" style_text_font="#font_heading_micro" style_text_color="#text_muted"/>
    <lv_label name="temp-spark__value"
              bind_text="temp-spark__value" style_text_font="#font_heading_medium" style_text_color="#text"/>
    <lv_obj name="temp-spark__bars"
            width="100%" flex_grow="1" flex_flow="row" style_pad_gap="#space_xxs" scrollable="false" style_bg_opa="0"
            style_border_width="0">
      <lv_bar name="temp-spark__bar1"
              height="100%" orientation="vertical" flex_grow="1" min_value="0" max_value="100"
              bind_value="temp-spark__bar1"/>
