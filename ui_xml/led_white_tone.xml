<!-- One white tone on the LEDs overlay: a round preview over its label, ringed
     while led_page_white_sel equals tone; a tap sends led_white_cb(tone). -->
<component>
  <api>
    <prop name="tone" type="string" default="0"/>
    <prop name="label" type="string" default=""/>
    <prop name="label_tag" type="string" default=""/>
    <prop name="color" type="string" default="#led_white_neutral"/>
  </api>
  <view name="led_white_tone"
        extends="lv_obj" width="content" height="content" flex_flow="column" style_flex_cross_place="center"
        style_pad_all="0" style_pad_gap="#space_xxs" style_bg_opa="0" style_border_width="0" clickable="true"
        scrollable="false">
    <lv_obj name="tone_swatch"
            width="#led_swatch_size" height="#led_swatch_size" style_radius="9999" style_bg_opa="255"
            style_bg_color="$color" style_border_width="0" clickable="false" event_bubble="true" scrollable="false">
      <bind_style_if_eq name="styles.led_swatch_ring" subject="led_page_white_sel" ref_value="$tone"/>
    </lv_obj>
    <text_small text="$label"
                translation_tag="$label_tag" style_text_color="#text_muted" clickable="false" event_bubble="true"/>
    <event_cb trigger="clicked" callback="led_white_cb" user_data="$tone"/>
  </view>
</component>
