<!-- Belt Tension Panel - Two resonance sweeps, compared -->
<!-- States: 0=START, 1=RUNNING, 2=RESULTS, 3=ERROR -->
<component>
  <styles>
    <!-- Verdict color follows the verdict the C++ computed; the A/B running
         title carries the same per-path color the results cards use. -->
    <style name="verdict_matched" text_color="#success"/>
    <style name="verdict_close" text_color="#warning"/>
    <style name="verdict_adjust" text_color="#danger"/>
    <style name="run_path_a" text_color="#primary"/>
    <style name="run_path_b" text_color="#warning"/>
  </styles>
  <view name="panel_belt_tension"
        extends="lv_obj" width="#overlay_width_transient" height="100%" align="right_mid" style_border_width="0"
        style_pad_all="0" style_bg_opa="255" style_bg_color="#card_bg" scrollable="false" flex_flow="column">
    <!-- Header Bar -->
    <header_bar name="overlay_header"
                title="Belt Tension" title_tag="Belt Tension" hide_action_button="true" action_button_icon="refresh"
                action_button_callback="belt_tension_start_cb" action_button_disabled_cond="nav_buttons_enabled eq 0"/>
    <!-- Content Area -->
    <lv_obj name="panel_content"
            width="100%" flex_grow="1" style_pad_top="0" style_pad_bottom="#space_lg" style_pad_left="#space_lg"
            style_pad_right="#space_lg" style_pad_gap="#space_md" scrollable="true" flex_flow="column">
      <!-- Disable content when printer not connected -->
      <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>
      <!-- ============================================================ -->
      <!-- STATE 0: START - Hardware summary + start button -->
      <!-- ============================================================ -->
      <lv_obj name="state_start"
              width="100%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_md"
              scrollable="false">
        <bind_flag_if_not_eq subject="belt_tension_state" flag="hidden" ref_value="0"/>
        <!-- Hardware summary card (with help button) -->
        <lv_obj width="100%"
                height="content" style_bg_color="#screen_bg" style_bg_opa="255" style_radius="#border_radius"
                style_pad_all="#space_lg" flex_flow="column" style_pad_gap="#space_sm" scrollable="false">
          <!-- Title row: icon + text + help button -->
          <lv_obj width="100%"
                  height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                  style_pad_gap="#space_sm" scrollable="false">
            <icon src="waveform" size="lg" variant="primary"/>
            <text_body text="Compare both belt paths"
                       translation_tag="Compare both belt paths" flex_grow="1" style_text_color="#text_muted"/>
            <ui_button name="btn_help"
                       width="#icon_button_size_lg" height="#icon_button_size_lg" variant="ghost" icon="help_circle">
              <event_cb trigger="clicked" callback="belt_tension_help_cb"/>
            </ui_button>
          </lv_obj>
          <!-- Kinematics row -->
          <lv_obj width="100%"
                  height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between"
                  style_flex_cross_place="center" scrollable="false">
            <text_body text="Kinematics" translation_tag="Kinematics"/>
            <text_body bind_text="bt_hw_kinematics" style_text_color="#primary"/>
          </lv_obj>
          <!-- Accelerometer row -->
          <lv_obj width="100%"
                  height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between"
                  style_flex_cross_place="center" scrollable="false">
            <text_body text="Accelerometer" translation_tag="Accelerometer"/>
            <text_body bind_text="bt_hw_accel" style_text_color="#primary"/>
          </lv_obj>
          <!-- Sweep row: the range comes from the printer's [resonance_tester] -->
          <lv_obj width="100%"
                  height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between"
                  style_flex_cross_place="center" scrollable="false">
            <text_body text="Sweep" translation_tag="Sweep"/>
            <text_body bind_text="bt_hw_sweep" style_text_color="#primary"/>
          </lv_obj>
        </lv_obj>
        <!-- Belt path sketch placeholder: the A/B diagram lands here -->
        <!-- SIZE_OK: 200x200 is this placeholder's own footprint; the belt_path_sketch
             widget replaces it with a measured diagram. -->
        <lv_obj name="bt_sketch"
                width="200" height="200" align="center" style_bg_color="#screen_bg" style_bg_opa="255"
                style_radius="#border_radius" style_border_width="1" style_border_color="#border" scrollable="false">
          <text_small text="Path A / Path B"
                      translation_tag="Path A / Path B" align="center" style_text_color="#text_muted"/>
        </lv_obj>
        <!-- Why Start is refused, shown only when it is -->
        <lv_obj width="100%"
                height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                style_pad_gap="#space_sm" scrollable="false">
          <bind_flag_if_eq subject="bt_can_start" flag="hidden" ref_value="1"/>
          <icon src="alert" size="md" variant="warning"/>
          <text_body name="bt_gate_message_label" flex_grow="1" bind_text="bt_gate_message" long_mode="wrap"/>
        </lv_obj>
        <!-- Start button. bind_state_if_eq is the hard gate: it is bound to a -->
        <!-- subject, so it holds however the user reached the panel and it -->
        <!-- re-arms if the accelerometer disappears mid-session. -->
        <ui_button name="btn_start"
                   width="100%" height="#button_height" icon="waveform" text="Start Check" translation_tag="Start Check"
                   variant="primary">
          <bind_state_if_eq subject="bt_can_start" state="disabled" ref_value="0"/>
          <event_cb trigger="clicked" callback="belt_tension_start_cb"/>
        </ui_button>
      </lv_obj>
      <!-- ============================================================ -->
      <!-- STATE 1: RUNNING - one sweep at a time -->
      <!-- ============================================================ -->
      <lv_obj name="state_running"
              width="100%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_md"
              scrollable="false">
        <bind_flag_if_not_eq subject="belt_tension_state" flag="hidden" ref_value="1"/>
        <text_heading width="100%" bind_text="bt_run_title" style_text_align="center">
          <bind_style_if_eq name="run_path_a" subject="bt_running_path" ref_value="0"/>
          <bind_style_if_eq name="run_path_b" subject="bt_running_path" ref_value="1"/>
        </text_heading>
        <text_body width="100%" bind_text="bt_run_detail" style_text_align="center" style_text_color="#text_muted"/>
        <!-- Live chart host; hidden on tiers that carry no chart -->
        <lv_obj name="chart_host_running"
                width="100%" height="180" style_pad_all="0" style_radius="#border_radius" style_bg_color="#screen_bg"
                style_bg_opa="255" scrollable="false">
          <bind_flag_if_eq subject="bt_chart_available" flag="hidden" ref_value="0"/>
        </lv_obj>
        <ui_button name="btn_stop"
                   width="100%" height="#button_height" icon="close" text="Stop" translation_tag="Stop" variant="danger">
          <event_cb trigger="clicked" callback="belt_tension_stop_cb"/>
        </ui_button>
        <text_small width="100%"
                    text="Do not open the printer while the toolhead is moving"
                    translation_tag="Do not open the printer while the toolhead is moving" style_text_align="center"
                    style_text_color="#text_muted"/>
      </lv_obj>
      <!-- ============================================================ -->
      <!-- STATE 2: RESULTS - both paths measured, compared -->
      <!-- ============================================================ -->
      <lv_obj name="state_results"
              width="100%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_md"
              scrollable="false">
        <bind_flag_if_not_eq subject="belt_tension_state" flag="hidden" ref_value="2"/>
        <text_heading name="bt_verdict_text" width="100%" bind_text="bt_verdict_text" style_text_align="center">
          <bind_style_if_eq name="verdict_matched" subject="bt_verdict" ref_value="0"/>
          <bind_style_if_eq name="verdict_close" subject="bt_verdict" ref_value="1"/>
          <bind_style_if_eq name="verdict_adjust" subject="bt_verdict" ref_value="2"/>
        </text_heading>
        <text_body width="100%" bind_text="bt_facts" style_text_align="center" style_text_color="#text_muted"/>
        <!-- Delta rail: A-minus-B in tenths of a Hz over +/-15 Hz. The bands -->
        <!-- mirror the verdict constants in belt_tension_types.h: MATCHED is -->
        <!-- +/-3 Hz = 3/15 = 20% of the span, CLOSE is +/-8 Hz = 8/15 = 53%. -->
        <!-- Keep these widths in step with MATCHED_DELTA_HZ/CLOSE_DELTA_HZ -->
        <!-- over BeltTensionPanel::RAIL_SPAN_HZ; the panel test pins them. -->
        <!-- SIZE_OK: 12px track and 2px end caps are this rail's own geometry; the
             nearest tokens belong to unrelated components. -->
        <lv_obj name="rail_track"
                width="100%" height="12" style_pad_all="0" style_radius="6" style_bg_color="#screen_bg"
                style_bg_opa="255" scrollable="false">
          <lv_obj name="rail_band_close"
                  width="53%" height="100%" align="center" style_bg_color="#warning" style_bg_opa="60" style_radius="6"
                  style_pad_all="0" scrollable="false"/>
          <lv_obj name="rail_band_matched"
                  width="20%" height="100%" align="center" style_bg_color="#primary" style_bg_opa="120" style_radius="6"
                  style_pad_all="0" scrollable="false"/>
          <lv_obj name="rail_end_a"
                  width="2" height="100%" align="left_mid" style_bg_color="#border" style_pad_all="0" scrollable="false"/>
          <lv_obj name="rail_end_b"
                  width="2" height="100%" align="right_mid" style_bg_color="#border" style_pad_all="0"
                  scrollable="false"/>
        </lv_obj>
        <lv_obj width="100%"
                height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between"
                scrollable="false">
          <text_small text="B runs faster" translation_tag="B runs faster" style_text_color="#text_muted"/>
          <text_small text="Matched" translation_tag="Matched" style_text_color="#primary"/>
          <text_small text="A runs faster" translation_tag="A runs faster" style_text_color="#text_muted"/>
        </lv_obj>
        <lv_slider name="bt_rail"
                   width="100%" min_value="-150" max_value="150" bind_value="bt_rail_value" style_bg_color="#screen_bg"/>
        <!-- Results chart host; hidden on tiers that carry no chart -->
        <lv_obj name="chart_host_results"
                width="100%" height="180" style_pad_all="0" style_radius="#border_radius" style_bg_color="#screen_bg"
                style_bg_opa="255" scrollable="false">
          <bind_flag_if_eq subject="bt_chart_available" flag="hidden" ref_value="0"/>
        </lv_obj>
        <!-- Path cards -->
        <lv_obj width="100%"
                height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_sm" scrollable="false">
          <lv_obj width="0"
                  height="content" flex_grow="1" style_bg_color="#screen_bg" style_bg_opa="255"
                  style_radius="#border_radius" style_pad_all="#space_md" flex_flow="column" style_pad_gap="#space_xs"
                  scrollable="false">
            <text_body width="100%" text="Path A" translation_tag="Path A"/>
            <text_heading name="bt_peak_a"
                          width="100%" bind_text="bt_peak_a" style_text_align="center" style_text_color="#primary"/>
            <text_small width="100%" bind_text="bt_note_a" style_text_align="center" style_text_color="#text_muted"/>
          </lv_obj>
          <lv_obj width="0"
                  height="content" flex_grow="1" style_bg_color="#screen_bg" style_bg_opa="255"
                  style_radius="#border_radius" style_pad_all="#space_md" flex_flow="column" style_pad_gap="#space_xs"
                  scrollable="false">
            <text_body width="100%" text="Path B" translation_tag="Path B"/>
            <text_heading name="bt_peak_b"
                          width="100%" bind_text="bt_peak_b" style_text_align="center" style_text_color="#warning"/>
            <text_small width="100%" bind_text="bt_note_b" style_text_align="center" style_text_color="#text_muted"/>
          </lv_obj>
        </lv_obj>
        <ui_button name="btn_test_both"
                   width="100%" height="#button_height" icon="restart" text="Test Both Again"
                   translation_tag="Test Both Again" variant="primary">
          <event_cb trigger="clicked" callback="belt_tension_start_cb"/>
        </ui_button>
        <lv_obj width="100%"
                height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_sm" scrollable="false">
          <ui_button name="btn_retest_a"
                     width="0" height="#button_height" flex_grow="1" icon="refresh" text="Re-test A"
                     translation_tag="Re-test A" variant="secondary">
            <event_cb trigger="clicked" callback="belt_tension_retest_a_cb"/>
          </ui_button>
          <ui_button name="btn_retest_b"
                     width="0" height="#button_height" flex_grow="1" icon="refresh" text="Re-test B"
                     translation_tag="Re-test B" variant="secondary">
            <event_cb trigger="clicked" callback="belt_tension_retest_b_cb"/>
          </ui_button>
        </lv_obj>
      </lv_obj>
      <!-- ============================================================ -->
      <!-- STATE 3: ERROR -->
      <!-- ============================================================ -->
      <lv_obj name="state_error"
              width="100%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_md"
              scrollable="false">
        <bind_flag_if_not_eq subject="belt_tension_state" flag="hidden" ref_value="3"/>
        <lv_obj width="100%"
                height="content" style_bg_color="#screen_bg" style_bg_opa="255" style_radius="#border_radius"
                style_pad_all="#space_lg" flex_flow="column" style_pad_gap="#space_sm" scrollable="false">
          <icon src="alert" size="lg" variant="warning" align="center"/>
          <text_body name="error_label"
                     width="100%" bind_text="bt_error_message" long_mode="wrap" style_text_align="center"/>
        </lv_obj>
        <ui_button name="btn_retry"
                   width="100%" height="#button_height" icon="refresh" text="Retry" translation_tag="Retry"
                   variant="primary">
          <event_cb trigger="clicked" callback="belt_tension_retry_cb"/>
        </ui_button>
      </lv_obj>
    </lv_obj>
  </view>
</component>
