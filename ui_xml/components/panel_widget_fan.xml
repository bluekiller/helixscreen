<component>
  <api>
    <!-- Per-instance subject names, supplied by the widget at creation. Two fan
         tiles size independently, so these cannot be type-global. -->
    <prop name="tile_icon_subject" type="string" default=""/>
    <prop name="tile_label_subject" type="string" default=""/>
    <prop name="tile_dir_subject" type="string" default=""/>
    <prop name="tile_target_subject" type="string" default=""/>
  </api>
  <view name="panel_widget_fan"
        extends="lv_obj" height="100%" flex_grow="1" style_pad_all="0" scrollable="false" flex_flow="column"
        style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center" clickable="true">
    <style name="styles.press_wash" selector="pressed"/>
    <bind_state_if_not_eq subject="printer_connection_state" state="disabled" ref_value="2"/>
    <event_cb trigger="clicked" callback="fan_widget_clicked_cb"/>
    <!-- Top row: icon + speed -->
    <!-- The icon and its reading sit in a row while there is width for one and
         stack when there is not. The verdict decides which; binding both styles
         means the flow follows the box rather than a fixed choice. -->
    <lv_obj name="fan_value_row"
            width="100%" height="content" style_pad_all="0" scrollable="false" style_flex_main_place="center"
            style_flex_cross_place="center" style_pad_gap="#space_xs" clickable="false" event_bubble="true">
      <bind_style_if_eq name="styles.tile_row" subject="$tile_dir_subject" ref_value="1"/>
      <bind_style_if_eq name="styles.tile_column" subject="$tile_dir_subject" ref_value="0"/>
      <icon name="fan_widget_icon" src="fan" size="#icon_size" variant="secondary" clickable="false" event_bubble="true">
        <bind_style_if_eq name="styles.tile_icon_xs" subject="$tile_icon_subject" ref_value="0"/>
        <bind_style_if_eq name="styles.tile_icon_sm" subject="$tile_icon_subject" ref_value="1"/>
        <bind_style_if_eq name="styles.tile_icon_md" subject="$tile_icon_subject" ref_value="2"/>
        <bind_style_if_eq name="styles.tile_icon_lg" subject="$tile_icon_subject" ref_value="3"/>
        <bind_style_if_eq name="styles.tile_icon_xl" subject="$tile_icon_subject" ref_value="4"/>
      </icon>
      <text_body name="fan_speed" text="--" clickable="false" event_bubble="true">
        <bind_style_if_eq name="styles.tile_value_xs" subject="$tile_icon_subject" ref_value="0"/>
        <bind_style_if_eq name="styles.tile_value_sm" subject="$tile_icon_subject" ref_value="1"/>
        <bind_style_if_eq name="styles.tile_value_md" subject="$tile_icon_subject" ref_value="2"/>
        <bind_style_if_eq name="styles.tile_value_lg" subject="$tile_icon_subject" ref_value="3"/>
        <bind_style_if_eq name="styles.tile_value_xl" subject="$tile_icon_subject" ref_value="4"/>
      </text_body>
    </lv_obj>
    <!-- Fan name label -->
    <text_tiny name="fan_name"
               width="100%" text="Select fan" translation_tag="Select fan" style_text_align="center" long_mode="dots"
               clickable="false" event_bubble="true">
      <bind_flag_if_eq subject="$tile_label_subject" flag="hidden" ref_value="0"/>
    </text_tiny>
  </view>
</component>
