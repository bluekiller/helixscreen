<!-- One device tab on the LEDs overlay: a state dot, then the device name.
     The dot is lit in the light's color when dot_subject reads 1 (on), hollow at 0 (off)
     and a dotted ring at 2 (state unknown). The focused tab is underlined. -->
<component>
  <api>
    <prop name="index" type="string" default="0"/>
    <prop name="label_subject" type="string" default=""/>
    <prop name="dot_subject" type="string" default=""/>
    <prop name="dot_color_subject" type="string" default=""/>
  </api>
  <styles>
    <!-- Two styles, not an inline attribute plus one: inline style props would
         override the bound style (rule 6). -->
    <style name="tab_focused" border_width="3" border_side="bottom" border_color="#primary" border_opa="255"/>
    <style name="tab_idle" border_width="0"/>
    <style name="label_focused" text_color="#text"/>
    <style name="label_idle" text_color="#text_muted"/>
  </styles>
  <view name="led_device_tab"
        extends="lv_button" width="content" height="#led_tab_height" flex_flow="row" style_flex_cross_place="center"
        style_pad_gap="#space_xs" style_pad_left="#space_sm" style_pad_right="#space_sm" style_pad_top="0"
        style_pad_bottom="0" style_radius="0" style_bg_opa="0" style_shadow_width="0" scrollable="false">
    <bind_style_if_eq name="tab_focused" subject="led_focused_tab" ref_value="$index"/>
    <bind_style_if_not_eq name="tab_idle" subject="led_focused_tab" ref_value="$index"/>
    <lv_obj name="dot_on"
            width="#led_dot_size" height="#led_dot_size" style_radius="9999" style_bg_opa="255" style_border_width="0"
            clickable="false" event_bubble="true" scrollable="false">
      <bind_style_prop prop="bg_color" subject="$dot_color_subject"/>
      <bind_flag_if_not_eq subject="$dot_subject" flag="hidden" ref_value="1"/>
    </lv_obj>
    <lv_obj name="dot_off"
            width="#led_dot_size" height="#led_dot_size" style_radius="9999" style_bg_opa="0" style_border_width="2"
            style_border_color="#text_muted" clickable="false" event_bubble="true" scrollable="false">
      <bind_flag_if_not_eq subject="$dot_subject" flag="hidden" ref_value="0"/>
    </lv_obj>
    <icon name="dot_unknown" src="dots_circle" size="xs" variant="muted" clickable="false" event_bubble="true">
      <bind_flag_if_not_eq subject="$dot_subject" flag="hidden" ref_value="2"/>
    </icon>
    <text_body name="tab_label" bind_text="$label_subject" clickable="false" event_bubble="true">
      <bind_style_if_eq name="label_focused" subject="led_focused_tab" ref_value="$index"/>
      <bind_style_if_not_eq name="label_idle" subject="led_focused_tab" ref_value="$index"/>
    </text_body>
    <event_cb trigger="clicked" callback="led_tab_clicked_cb" user_data="$index"/>
  </view>
</component>
