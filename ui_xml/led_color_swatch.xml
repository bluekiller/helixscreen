<!-- One round color swatch on the LEDs overlay: fill from color_subject, a ring
     while led_selected_swatch equals index, a tap sends led_swatch_cb(index). -->
<component>
  <api>
    <prop name="index" type="string" default="0"/>
    <prop name="color_subject" type="string" default=""/>
  </api>
  <view extends="lv_obj"
        width="#led_swatch_size" height="#led_swatch_size" style_radius="9999" style_bg_opa="255" style_border_width="0"
        style_pad_all="0" clickable="true" scrollable="false">
    <bind_style_prop prop="bg_color" subject="$color_subject"/>
    <bind_style_if_eq name="styles.led_swatch_ring" subject="led_selected_swatch" ref_value="$index"/>
    <event_cb trigger="clicked" callback="led_swatch_cb" user_data="$index"/>
  </view>
</component>
